  "experiments": [
    {
      "name": "expert_vk_no_mtp",
      "description": "dGPU owns shared/dense/attention tensors; APU owns PLE and non-shared routed experts.",
      "backend": "vulkan",
      "baseline": true,
      "server": "{vulkan_server}",
      "model": "{model_ple16}",
      "args": [
        "--device",
        "Vulkan0,Vulkan1",
        "--split-mode",
        "layer",
        "--tensor-split",
        "1,0",
        "--override-tensor",
        "^ple_ngram_embd\\.[0-9]+\\.weight$=Vulkan1,^blk\\.[0-9]+\\.ffn_(down|gate|up)_exps\\.weight$=Vulkan1"
      ]
    },
    {
      "name": "layer_85_15_vk_no_mtp",
      "description": "Contiguous Vulkan layer split, APU first and dGPU second.",
      "backend": "vulkan",
      "server": "{vulkan_server}",
      "model": "{model_ple16}",
      "args": [
