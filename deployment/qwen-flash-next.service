[Unit]
Description=Qwen3.8 Flash Next ROCm production server
Documentation=https://github.com/Dillflix/qwen-flash-next-bench
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=jdillman
Group=jdillman
WorkingDirectory=/srv/llm
EnvironmentFile=/etc/qwen-flash-next.env
Environment=XDG_CACHE_HOME=/var/cache/qwen-flash-next
ExecStartPre=/usr/local/libexec/qwen-flash-next --check
ExecStartPre=/usr/bin/python3 /usr/local/libexec/qwen-flash-next-prime --check
ExecStart=/usr/local/libexec/qwen-flash-next
ExecStartPost=/usr/bin/python3 /usr/local/libexec/qwen-flash-next-prime
Restart=on-failure
RestartPreventExitStatus=64 66
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
KillSignal=SIGINT
KillMode=mixed
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=4096
UMask=0027

# Keep the model tree and system immutable while retaining a private ROCm cache.
CacheDirectory=qwen-flash-next
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
