# Copy to /etc/qwen-flash-next.env and restrict it to root plus the service user.
LLAMA_SERVER=/srv/llm/src/llama-qwen4exp/build-vulkan/bin/llama-server
MODEL=/srv/llm/models/qwen-flash-next/Qwen3.8-Flash-Next-Q4_0-ROCmFP4-STRIX-PLE16.gguf
MTP=/srv/llm/models/qwen-flash-next/mtp-Qwen3.8-Flash-Next-Q8_0.gguf

# Use 88,12 only after production-capacity passes. Fall back to 90,10 otherwise.
TARGET_SPLIT=88,12
THREADS=16
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Required when LLAMA_HOST is not loopback. Do not commit a real key.
API_KEY=
