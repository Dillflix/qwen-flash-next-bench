# Installed as /etc/qwen-flash-next.env with mode 0640, root:jdillman.
LLAMA_SERVER=/srv/llm/src/ROCmFPX-qwen4exp/build-hip10-dual/bin/llama-server
MODEL=/srv/llm/models/qwen-flash-next/Qwen3.8-Flash-Next-Q4_0-ROCmFP4-STRIX.gguf
MTP=/srv/llm/models/qwen-flash-next/mtp-Qwen3.8-Flash-Next-Q8_0.gguf
MMPROJ=/srv/llm/models/qwen-flash-next/mmproj-Qwen3.8-Flash-Next-BF16.gguf

# Qualified text deployment: strict multi-row verification with bounded
# recurrent rollback. Multimodal requests automatically bypass MTP and use the
# target model because vision+MTP is not qualified.
LLAMA_MTP_MODE=strict
LLAMA_CONTEXT_SIZE=262144

# Required for strict mode. systemd remains in "activating" state until a
# bounded synthetic n=3 request initializes the MTP graph. This is a roughly
# 2K-4K-token calibration prompt, not a 256K prefill.
LLAMA_STARTUP_PRIME=1
LLAMA_STARTUP_PRIME_TIMEOUT=1800
LLAMA_STARTUP_PRIME_REQUEST_TIMEOUT=300

# Leave empty in production. Set to an existing writable absolute directory
# only while running diagnostics that erase slot 0 between requests.
LLAMA_SLOT_SAVE_PATH=

# Pin the service to the ROCm 10 runtime used by the qualified build.
ROCM_PATH=/opt/rocm-10.0.0
HIP_PATH=/opt/rocm-10.0.0
LD_LIBRARY_PATH=/opt/rocm-10.0.0/lib:/opt/rocm-10.0.0/lib/rocm_sysdeps/lib

TARGET_SPLIT=88,12
THREADS=16
# Loopback accepts connections only from this host. For direct LAN access, use
# the server's LAN address (for example 192.168.0.138) and configure an API key.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Authentication option 1: native llama-server environment variable.
# Multiple comma-separated keys are supported. Quote values containing spaces.
LLAMA_API_KEY=

# Authentication option 2 (preferred for a service): one key per line in a
# root-managed file readable by jdillman. Leave blank when using LLAMA_API_KEY.
LLAMA_ARG_API_KEY_FILE=
