+    : graph(model, params, true) {
+    GGML_ASSERT(hparams.nextn_predict_layers == 1 &&
+                "qwen4exp MTP requires exactly one appended prediction layer");
+    GGML_ASSERT(ubatch.token && "qwen4exp MTP requires token input");
+
+    const int64_t hc = hparams.n_hc;
+    const int il = (int) hparams.n_layer - (int) hparams.nextn_predict_layers;
+    const auto & layer = model.layers[il];
+
+    GGML_ASSERT(layer.nextn.eh_proj && "qwen4exp MTP block is missing nextn.eh_proj");
+    GGML_ASSERT(layer.nextn.enorm   && "qwen4exp MTP block is missing nextn.enorm");
+    GGML_ASSERT(layer.nextn.hnorm   && "qwen4exp MTP block is missing nextn.hnorm");
+
+    int sections[4];
