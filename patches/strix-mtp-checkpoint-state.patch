+    bool get_state(llama_seq_id seq_id, std::vector<uint8_t> & data) const override {
+        if (seq_id < 0 || seq_id >= (llama_seq_id) n_seq) {
+            data.clear();
+            return false;
+        }
+
+        // The draft KV does not contain the deferred target hidden row.
+        const uint32_t header[] = { 0x4d545031u, (uint32_t) n_embd }; // MTP1
+        const size_t row_bytes = (size_t) n_embd * sizeof(float);
+        GGML_ASSERT(pending_h[seq_id].size() == (size_t) n_embd);
+        data.resize(sizeof(header) + row_bytes);
+        std::memcpy(data.data(), header, sizeof(header));
+        std::memcpy(data.data() + sizeof(header), pending_h[seq_id].data(), row_bytes);
+        return true;
+    }
+
+    void set_state(llama_seq_id seq_id, const std::vector<uint8_t> & data) override {
+        if (seq_id < 0 || seq_id >= (llama_seq_id) n_seq) {
+            return;
+        }
+
+        uint32_t header[2] = {};
+        const size_t row_bytes = (size_t) n_embd * sizeof(float);
+        if (data.size() != sizeof(header) + row_bytes) {
+            GGML_ABORT("MTP checkpoint state has an invalid size");
+        }
+        std::memcpy(header, data.data(), sizeof(header));
+        if (header[0] != 0x4d545031u || header[1] != (uint32_t) n_embd) {
+            GGML_ABORT("MTP checkpoint state has an invalid version or width");
+        }
+        pending_h[seq_id].resize(n_embd);
+        std::memcpy(pending_h[seq_id].data(), data.data() + sizeof(header), row_bytes);
+
+        // Batch-local rows and indices belong to the abandoned continuation.
+        verify_h[seq_id].clear();
+        verify_h_rows[seq_id] = 0;
+        i_batch_beg[seq_id] = -1;
+        i_batch_end[seq_id] = -1;
+        i_last[seq_id] = -1;
+        if (chain_heads) {
+            chain_h[seq_id].clear();
+        }
+        SPC_DBG("MTP checkpoint carry restored: seq=%d, width=%d\n", (int) seq_id, n_embd);
+    }
