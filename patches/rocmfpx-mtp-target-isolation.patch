+int llama_context::decode_outer_serial_preserve_outputs(const llama_batch & batch_inp) {
+    if (batch_inp.n_tokens <= 1) {
+        return decode(batch_inp);
+    }
+
+    if (!batch_inp.token || batch_inp.embd || !batch_inp.logits) {
+        LLAMA_LOG_ERROR("%s: diagnostic serial decode requires token-only input and explicit logits rows\n", __func__);
+        return -1;
+    }
+    if (!batch_inp.pos || !batch_inp.n_seq_id || !batch_inp.seq_id) {
+        LLAMA_LOG_ERROR("%s: diagnostic serial decode requires explicit positions and sequence metadata\n", __func__);
+        return -1;
+    }
+    if ((uint32_t) batch_inp.n_tokens > cparams.n_batch) {
+        LLAMA_LOG_ERROR("%s: diagnostic row count exceeds the configured physical batch size\n", __func__);
+        return -1;
+    }
+    if (!sampling.samplers.empty()) {
+        LLAMA_LOG_ERROR("%s: diagnostic serial decode requires CPU-side target sampling\n", __func__);
+        return -1;
+    }
+    if (!cparams.embeddings_pre_norm || cparams.embeddings_pre_norm_masked) {
+        LLAMA_LOG_ERROR("%s: diagnostic serial decode requires unmasked pre-norm output\n", __func__);
+        return -1;
+    }
+    if (cparams.embeddings || std::any_of(
+            cparams.embeddings_layer_inp.begin(), cparams.embeddings_layer_inp.end(),
+            [](bool enabled) { return enabled; })) {
+        LLAMA_LOG_ERROR("%s: ordinary and layer-input embedding export is unsupported\n", __func__);
+        return -1;
+    }
+
+    const llama_seq_id verifier_seq = batch_inp.seq_id[0] ? batch_inp.seq_id[0][0] : -1;
+    const llama_pos verifier_pos = batch_inp.pos[0];
+    for (int32_t i = 0; i < batch_inp.n_tokens; ++i) {
+        if (batch_inp.logits[i] == 0 || batch_inp.n_seq_id[i] != 1 || !batch_inp.seq_id[i] ||
+                batch_inp.seq_id[i][0] != verifier_seq || batch_inp.pos[i] != verifier_pos + i) {
+            LLAMA_LOG_ERROR("%s: verifier rows must be one consecutive sequence with logits enabled\n", __func__);
+            return -1;
+        }
+    }
+
+    const size_t n_rows  = (size_t) batch_inp.n_tokens;
+    const size_t n_vocab = (size_t) model.vocab.n_tokens();
+    const size_t n_embd  = (size_t) model.n_embd_pre_norm();
+    std::vector<float> saved_logits(n_rows * n_vocab);
+    std::vector<float> saved_pre_norm(n_rows * n_embd);
+
+    for (int32_t i = 0; i < batch_inp.n_tokens; ++i) {
+        llama_batch row = {
+            1,
+            batch_inp.token + i,
+            nullptr,
+            batch_inp.pos + i,
+            batch_inp.n_seq_id + i,
+            batch_inp.seq_id + i,
+            batch_inp.logits + i,
+        };
+
+        const int ret = decode(row);
+        if (ret != 0) {
+            LLAMA_LOG_ERROR("%s: verifier row %d failed after earlier rows may have committed, ret = %d\n", __func__, i, ret);
+            return -2;
+        }
+
+        synchronize();
+        const float * row_logits = get_logits_ith(0);
+        const float * row_pre_norm = get_embeddings_pre_norm_ith(0);
+        if (!row_logits || !row_pre_norm) {
+            LLAMA_LOG_ERROR("%s: verifier row %d did not produce logits and pre-norm output\n", __func__, i);
+            return -2;
+        }
+        std::memcpy(saved_logits.data() + (size_t) i * n_vocab, row_logits, n_vocab * sizeof(float));
+        std::memcpy(saved_pre_norm.data() + (size_t) i * n_embd, row_pre_norm, n_embd * sizeof(float));
+    }
+
+    if (output_reserve((int32_t) n_rows) < n_rows) {
+        LLAMA_LOG_ERROR("%s: could not restore %zu diagnostic output rows\n", __func__, n_rows);
+        return -2;
+    }
+
+    std::memcpy(logits.data, saved_logits.data(), saved_logits.size() * sizeof(float));
+    std::memcpy(embd_pre_norm.data, saved_pre_norm.data(), saved_pre_norm.size() * sizeof(float));
+    n_outputs = (uint32_t) n_rows;
+    output_swaps.clear();
+    for (int32_t i = 0; i < batch_inp.n_tokens; ++i) {
+        output_ids[i] = i;
+    }
+
+    LLAMA_LOG_DEBUG("%s: preserved %zu true outer-decode verifier rows\n", __func__, n_rows);
+    return 0;
+}
