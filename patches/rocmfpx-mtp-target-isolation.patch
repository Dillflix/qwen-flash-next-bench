+int32_t llama_decode_outer_serial_preserve_outputs(
+        llama_context * ctx,
+          llama_batch   batch) {
+    const int ret = ctx->decode_outer_serial_preserve_outputs(batch);
+    if (ret != 0 && ret != 1) {
+        LLAMA_LOG_ERROR("%s: failed to decode, ret = %d\n", __func__, ret);
+    }
+
+    return ret;
+}
