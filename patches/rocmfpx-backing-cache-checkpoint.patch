diff --git a/src/llama-ple-state.h b/src/llama-ple-state.h
new file mode 100644
--- /dev/null
+++ b/src/llama-ple-state.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+#include <stdexcept>
+#include <utility>
+
+// Qwen4Exp PLE history is model-side state, not part of the KV/recurrent memory.
+// Include it in every sequence snapshot (including PARTIAL_ONLY checkpoints).
+// Old Qwen snapshots lack this trailer and must be rejected, never guessed.
+template<class IO, class History>
+void qwen_ple_state_write(IO & io, const History & history) {
+    const uint32_t tag = 0x504c4501;
+    const uint64_t count = history.toks.size();
+    io.write(&tag, sizeof(tag));
+    io.write(&history.first_pos, sizeof(history.first_pos));
+    io.write(&history.next_pos, sizeof(history.next_pos));
+    io.write(&count, sizeof(count));
+    if (count) {
+        io.write(history.toks.data(), count * sizeof(history.toks[0]));
+    }
+}
+
+template<class IO, class History>
+void qwen_ple_state_read(IO & io, History & history, uint64_t max_tokens) {
+    History restored;
+    uint32_t tag = 0;
+    uint64_t count = 0;
+    io.read(&tag, sizeof(tag));
+    if (tag != 0x504c4501) {
+        throw std::runtime_error("Qwen4Exp PLE snapshot version mismatch; discard old cache files");
+    }
+    io.read(&restored.first_pos, sizeof(restored.first_pos));
+    io.read(&restored.next_pos, sizeof(restored.next_pos));
+    io.read(&count, sizeof(count));
+    const bool empty = count == 0 && restored.first_pos == -1 && restored.next_pos == -1;
+    if (count > max_tokens || (!empty && (restored.first_pos < 0 ||
+            restored.next_pos < restored.first_pos ||
+            uint64_t(int64_t(restored.next_pos) - restored.first_pos) != count))) {
+        throw std::runtime_error("invalid Qwen4Exp PLE snapshot history");
+    }
+    restored.toks.resize(count);
+    if (count) {
+        io.read(restored.toks.data(), count * sizeof(restored.toks[0]));
+    }
+    history = std::move(restored);
+}
diff --git a/tools/server/server-cache-checkpoint.h b/tools/server/server-cache-checkpoint.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-cache-checkpoint.h
@@ -0,0 +1,25 @@
+#pragma once
+
+// A checkpoint at p0 includes the first differing token and is too late.
+// Metadata alone (as in disk-cache entries) is not a restorable checkpoint.
+template<class Checkpoint, class Position>
+bool server_cache_checkpoint_usable(const Checkpoint & ckpt, int lcp, Position p0, bool has_draft) {
+    return ckpt.n_tokens > 0 && ckpt.n_tokens <= lcp &&
+           ckpt.pos_min >= 0 && ckpt.pos_min <= ckpt.pos_max && ckpt.pos_max < p0 &&
+           !ckpt.data_tgt.empty() && (!has_draft || !ckpt.data_dft.empty()) &&
+           !ckpt.data_spec.empty();
+}
+
+template<class Prompt>
+int server_cache_checkpoint_prefix(const Prompt & prompt, int lcp, bool has_draft) {
+    if (lcp <= 0) {
+        return 0;
+    }
+    const auto p0 = prompt.tokens.pos_next(lcp);
+    for (auto it = prompt.checkpoints.rbegin(); it != prompt.checkpoints.rend(); ++it) {
+        if (server_cache_checkpoint_usable(*it, lcp, p0, has_draft)) {
+            return int(it->n_tokens);
+        }
+    }
+    return 0;
+}
